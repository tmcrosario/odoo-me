# Validation errors — me.document_exp
# ---------------------------------------------------------------------------

#. module: me
#: code:addons/me/models/document_exp.py:0
#, python-format
msgid "The document date is required."
msgstr "La fecha de inicio del trámite es obligatoria."

#. module: me
#: code:addons/me/models/document_exp.py:0
#, python-format
msgid "Intake date cannot be in the future."
msgstr "La fecha de ingreso no puede ser una fecha futura."

#. module: me
#: code:addons/me/models/document_exp.py:0
#, python-format
msgid ""
"The origin dependence '%(dep)s' is not allowed. "
"Only DEM, TMC and CM are accepted."
msgstr ""
"La dependencia de origen '%(dep)s' no está permitida. "
"Solo se aceptan DEM, TMC y CM."

#. module: me
#: code:addons/me/models/document_exp.py:0
#, python-format
msgid ""
"The source dependence is required "
"when the selected jurisdiction has sub-dependences available."
msgstr ""
"La repartición es obligatoria "
"cuando la jurisdicción seleccionada tiene reparticiones disponibles."

#. module: me
#: code:addons/me/models/document_exp.py:0
#, python-format
msgid ""
"The page count of the expediente cannot be modified after creation. "
"Variations must be recorded through movements. "
"Only an Intake Register manager can correct this value."
msgstr ""
"El número de fojas del expediente no puede modificarse después de la creación. "
"Las variaciones deben registrarse a través de movimientos. "
"Solo un responsable de Mesa de Entrada puede corregir este valor."

#. module: me
#: code:addons/me/models/document_exp.py:0
#, python-format
msgid "Existing Expediente"
msgstr "Expediente Existente"

#. module: me
#: code:addons/me/models/document_exp.py:0
#, python-format
msgid "An expediente with this data already exists. Please verify the information."
msgstr "Ya existe un expediente con estos datos. Por favor, verifique la información."

