# Validation errors — me.document_movement
# ---------------------------------------------------------------------------

#. module: me
#: code:addons/me/models/document_movement.py:0
#, python-format
msgid "Movement date cannot be in the future."
msgstr "La fecha del movimiento no puede ser una fecha futura."

#. module: me
#: code:addons/me/models/document_movement.py:0
#, python-format
msgid ""
"Movement date cannot be earlier than "
"the expediente intake date (%(intake)s)."
msgstr ""
"La fecha del movimiento no puede ser anterior "
"a la fecha de ingreso del expediente (%(intake)s)."

#. module: me
#: constraint:me.document_movement:0
msgid ""
"An identical movement already exists for this expediente "
"(same origin, destination and exact date)."
msgstr ""
"Ya existe un movimiento idéntico para este expediente "
"(misma origen, destino y fecha exacta)."

#. module: me
#: model:ir.model.fields,field_description:me.field_me_document_movement__legajo_number
msgid "File Number"
msgstr "Número de Legajo"

#. module: me
#: model:ir.model.fields,field_description:me.field_me_document_movement__destination_abbreviation
msgid "Destination Abbreviation"
msgstr "Abreviación del Destino"

#. module: me
#: code:addons/me/models/document_movement.py:0
#, python-format
msgid "File number is required when the destination is 'Adjunto a Legajo'."
msgstr "El número de legajo es obligatorio cuando el destino es 'Adjunto a Legajo'."

#. module: me
#: code:addons/me/models/document_exp.py:0
#, python-format
msgid "Only the current holder of the expediente can register a new movement."
msgstr "Solo el responsable actual del expediente puede registrar un nuevo pase."

#. module: me
#: code:addons/me/models/document_movement.py:0
#, python-format
msgid "Only the current holder of the expediente can correct a movement."
msgstr "Solo el responsable actual del expediente puede corregir este movimiento."

#. module: me
#: code:addons/me/models/document_movement.py:0
#, python-format
msgid "File number can only be set on movements with destination 'Adjunto a Legajo'."
msgstr "El número de legajo solo puede modificarse en movimientos con destino 'Adjunto a Legajo'."

#. module: me
#: model:ir.model.fields,field_description:me.field_tmc_dependence__default_responsible_id
msgid "Default Responsible"
msgstr "Responsable por Defecto"

#. module: me
#: code:addons/me/models/document_exp.py:0
#, python-format
msgid "Invalid Number"
msgstr "Número inválido"

msgid "Expediente number must be between 1 and 999,999 (6 digits maximum)."
msgstr "El número de expediente debe estar entre 1 y 999.999 (máximo 6 dígitos)."

#. module: me
#: model:ir.ui.view,arch_db:me.document_exp_view_search
msgid "In My Possession"
msgstr "En mi poder"

#. module: me
#: model:ir.model.fields,field_description:me.field_me_document_exp__current_holder_id
msgid "Current Holder"
msgstr "Responsable Actual"

#. module: me
#: code:addons/me/models/document_exp.py:0
#, python-format
msgid ""
"The jurisdiction is required for DEM expedientes with topic Nota; it must be "
"loaded at intake."
msgstr ""
"La jurisdicción es obligatoria para expedientes DEM con tema Nota; se debe "
"cargar al ingreso."

#. module: me
#: code:addons/me/models/document_exp.py:0
#, python-format
msgid ""
"The origin cannot be set from JUNCO on an expediente with topic Nota: its "
"jurisdiction and source are loaded in ME at intake."
msgstr ""
"El origen no puede completarse desde JUNCO en un expediente con tema Nota: su "
"jurisdicción y repartición se cargan en Mesa al ingreso."

#. module: me
#: code:addons/me/models/document_exp.py:0
#, python-format
msgid "The document date cannot be in the future."
msgstr "La fecha de inicio del trámite no puede ser futura."

#. module: me
#: code:addons/me/models/document_exp.py:0
#, python-format
msgid ""
"The intake date (%(intake)s) cannot be earlier than the expediente period "
"(%(period)s)."
msgstr ""
"La fecha de ingreso (%(intake)s) no puede ser anterior al período del "
"expediente (%(period)s)."

#. module: me
#: code:addons/me/models/document_exp.py:0
#, python-format
msgid ""
"The intake date (%(intake)s) cannot be earlier than the document date "
"(%(doc)s): the expediente cannot be received before it exists."
msgstr ""
"La fecha de ingreso (%(intake)s) no puede ser anterior a la fecha de inicio "
"del trámite (%(doc)s): el expediente no puede ingresar antes de existir."

#. module: me
