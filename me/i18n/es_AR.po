msgid "Procedure Start Date"
msgstr "Fecha de inicio del trámite"

#. module: me
#: model_terms:ir.ui.view,arch_db:me.document_exp_view_form
msgid ""
"Expediente creation date (from the cover sheet). May differ from the intake "
"date."
msgstr ""
"Fecha de creación del expediente (la de la carátula). Puede diferir de la "
"fecha de ingreso a Mesa."

#. module: me
#: model_terms:ir.ui.view,arch_db:me.document_exp_view_form
msgid "Date of the document or procedure"
msgstr "Fecha del documento o trámite"

#. module: me
#: model_terms:ir.ui.view,arch_db:me.document_exp_view_form
msgid "Movements"
msgstr "Movimientos"

#. module: me
#: model_terms:ir.ui.view,arch_db:me.document_exp_view_form
msgid "Related Documents"
msgstr "Documentos Relacionados"

#. module: me
#: model:ir.model.fields,field_description:me.field_me_document_exp__has_reentry
msgid "Has Reentry"
msgstr "Con Reingreso"

#. module: me
#: model:ir.model.fields,help:me.field_me_document_exp__has_reentry
msgid ""
"True when the expediente has left the Tribunal at least once "
"(movement to an external dependence) and then returned "
"(subsequent movement to an internal dependence)."
msgstr ""
"Verdadero cuando el expediente salió del Tribunal al menos una vez "
"(movimiento a una dependencia externa) y luego reingresó "
"(movimiento posterior a una dependencia interna)."

#. module: me
#: model:ir.model.fields,field_description:me.field_tmc_dependence__is_internal
msgid "Internal"
msgstr "Interna"

#. module: me
#: model:ir.model.fields,help:me.field_tmc_dependence__is_internal
msgid ""
"True when this dependence belongs to the Tribunal "
"(internal routing unit). Used to detect institutional reentry "
"in expediente movement sequences."
msgstr ""
"Verdadero cuando esta dependencia pertenece al Tribunal "
"(unidad de circulación interna). Se usa para detectar reingresos "
"institucionales en la secuencia de movimientos de expedientes."

#. module: me
#: model_terms:ir.ui.view,arch_db:me.document_exp_view_search
msgid "With Institutional Reentry"
msgstr "Con Reingreso Institucional"

#. module: me
#: model_terms:ir.ui.view,arch_db:me.document_exp_view_search
msgid "Currently at Tribunal"
msgstr "Actualmente en el Tribunal"

#. module: me
#: model_terms:ir.ui.view,arch_db:me.document_exp_view_search
msgid "Licitaciones"
msgstr "Licitaciones"

#. module: me
#: model_terms:ir.ui.view,arch_db:me.document_exp_view_search
msgid "Originated at TMC"
msgstr "Originados en el TMC"

#. module: me
#: model:ir.model.fields,field_description:me.field_me_document_exp__is_currently_internal
msgid "Currently at Tribunal"
msgstr "Actualmente en el Tribunal"

#. module: me
#: model:ir.model.fields,help:me.field_me_document_exp__is_currently_internal
msgid ""
"True when the last registered movement of the expediente has a "
"destination that belongs to the Tribunal (is_internal=True)."
msgstr ""
"Verdadero cuando el último movimiento registrado del expediente tiene "
"un destino que pertenece al Tribunal (is_internal=True)."

#. module: me
#: model:ir.model.fields,field_description:me.field_me_document_exp__is_licitacion
msgid "Licitación"
msgstr "Licitación"

#. module: me
#: model:ir.model.fields,help:me.field_me_document_exp__is_licitacion
msgid "True when the expediente's main topic is Licitación."
msgstr "Verdadero cuando el tema principal del expediente es Licitación."

