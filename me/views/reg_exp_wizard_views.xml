<odoo>
    <!-- Vista del Wizard -->
    <record id="view_reg_exp_wizard" model="ir.ui.view">
        <field name="name">reg.exp.wizard.form</field>
        <field name="model">reg.exp.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear Nuevo Expediente">
                <sheet>
                    <group string="Datos del Documento">
                        <field name="name" required="1"/>
                        <!-- <field name="document_object"/> -->
                        <field name="date"/>
                    </group>
                    <group string="Datos del Expediente">
                        <field name="external_key"/>
                        <!-- <field name="case_number"/> -->
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción para Abrir el Wizard -->
    <record id="action_reg_exp_wizard" model="ir.actions.act_window">
        <field name="name">Crear Expediente</field>
        <field name="res_model">reg.exp.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

