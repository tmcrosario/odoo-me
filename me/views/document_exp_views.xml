<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- List View -->
    <record id="document_exp_view_tree" model="ir.ui.view">
        <field name="name">me.registry.exp.view.tree</field>
        <field name="model">me.document_exp</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Document"/>
                <field name="intake_date"/>
                <field name="topics_display_name" string="Subject"/>
                <field name="document_object" string="Reference"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="document_exp_view_form" model="ir.ui.view">
        <field name="name">me.registry.exp.view.form</field>
        <field name="model">me.document_exp</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Textual Save, visible only when the form is dirty. No state
                         widget here: this header exists only to host the button, and
                         me_form_save_button.scss collapses the empty bar while clean. -->
                    <button string="Save" special="save"
                            class="btn-outline-primary o_me_form_save_button"
                            title="Save changes" data-hotkey="s"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="computed_name"
                            string="Expediente Name" />
                        <h1>
                            <field name="computed_name"
                            readonly="1"
                            placeholder="Fill in the basic fields to generate the name"/>
                        </h1>
                    </div>
                    <field name="is_valid" invisible="1"/>
                    <field name="is_origin_complete" invisible="1"/>
                    <field name="is_nota" invisible="1"/>
                    <field name="dependence_abbreviation" invisible="1"/>
                    <field name="allowed_sub_dependence_ids" invisible="1"/>
                    <field name="allowed_exp_topic_ids" invisible="1"/>
                    <field name="allowed_jurisdiction_ids" invisible="1"/>

                    <!-- Fase 1 — siempre visible -->
                    <group>
                        <group>
                            <field name="dependence_id" domain="[('abbreviation', 'in', ['DEM', 'TMC', 'CM'])]"/>
                            <field name="document_type_id" readonly="1" invisible="not dependence_id"/>
                        </group>
                        <group>
                            <field name="number" required="1" min="1" max="999999"
                                   widget="integer" options="{'enable_formatting': false}"/>
                            <field name="period"/>
                        </group>
                    </group>

                    <!-- Fase 2 — visible cuando is_origin_complete (para todos los orígenes) -->
                    <!-- Para CM: jurisdiction y source ocultos individualmente; intake_date siempre visible -->
                    <!-- El asunto va ARRIBA de la jurisdicción porque la gobierna: en DEM + Nota
                         habilita su carga (EPIC-004/TASK-002). Elegir el tema primero evita que
                         los campos aparezcan por encima de donde está mirando el usuario.
                         OJO con el readonly de jurisdiction/source: NO condicionarlo al valor
                         actual del campo (p.ej. `id and jurisdiction_dependence`). El cliente
                         evalúa la expresión contra el valor EN EDICIÓN, así que el campo se
                         bloquea apenas se lo completa y, peor, Odoo NO envía los campos readonly
                         al guardar: el valor se pierde y salta "jurisdiction is required".
                         El "solo al ingreso" lo hace cumplir el guard de write() (el operativo no
                         puede escribir estos campos en un expediente ya guardado; el Responsable
                         sí), no la vista. -->
                    <group invisible="not is_origin_complete">
                        <group>
                            <field name="main_topic_id"/>
                            <field name="secondary_topic_id" invisible="not main_topic_id"/>
                            <field name="document_object" string="Reference"/>
                            <field name="jurisdiction_dependence"
                                   domain="[('id', 'in', allowed_jurisdiction_ids)]"
                                   required="dependence_abbreviation == 'DEM' and is_nota and not id"
                                   readonly="dependence_abbreviation == 'TMC' or (dependence_abbreviation == 'DEM' and not is_nota)"
                                   invisible="dependence_abbreviation == 'CM' or (dependence_abbreviation == 'DEM' and not jurisdiction_dependence and not is_nota)"/>
                            <field name="source_dependence_id"
                                   domain="[('id', 'in', allowed_sub_dependence_ids)]"
                                   required="allowed_sub_dependence_ids"
                                   readonly="dependence_abbreviation == 'DEM' and not is_nota"
                                   invisible="dependence_abbreviation == 'CM' or (dependence_abbreviation == 'DEM' and not source_dependence_id and not is_nota)"/>
                        </group>
                        <!-- Columna derecha: cuándo y cuánto. Las dos fechas van juntas
                             (antes document_date quedaba en otro bloque, lejos de intake_date). -->
                        <group>
                            <field name="intake_date"/>
                            <field name="date" string="Procedure Start Date"
                                   help="Expediente creation date (from the cover sheet). May differ from the intake date."
                                   required="1"/>
                            <field name="fojas" required="1" readonly="id"/>
                            <field name="external_key"/>
                        </group>
                    </group>
                    <notebook invisible="not id">
                        <page string="Movements">
                            <field name="document_movement_ids" mode="list,form" context="{'default_expediente_id': id}">
                                <list>
                                    <field name="is_automatic" column_invisible="1"/>
                                    <field name="date"/>
                                    <field name="origin_dependence_id" options="{'no_open': True}"/>
                                    <field name="destination_dependence_id" options="{'no_open': True}"/>
                                    <field name="fojas" readonly="is_automatic"/>
                                    <field name="user_id" readonly="is_automatic"/>
                                    <field name="legajo_number" optional="hide" readonly="1"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="is_automatic" invisible="1"/>
                                        <field name="destination_abbreviation" invisible="1"/>
                                        <field name="date"/>
                                        <field name="origin_dependence_id" options="{'no_open': True}"/>
                                        <field name="destination_dependence_id" options="{'no_open': True}"/>
                                        <field name="legajo_number"
                                               invisible="destination_abbreviation != 'LEG'"
                                               required="destination_abbreviation == 'LEG'"/>
                                        <field name="fojas" readonly="is_automatic"/>
                                        <field name="user_id" readonly="is_automatic"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Related Documents" invisible="1">
                            <field name="related_document_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="document_exp_view_search" model="ir.ui.view">
        <field name="name">me.registry.exp.view.search</field>
        <field name="model">me.document_exp</field>
        <field name="arch" type="xml">
            <search>
                <searchpanel>
                    <field name="dependence_id" string="Origen" select="one"/>
                </searchpanel>
                <field name="name"/>
                <field name="number"/>
                <field name="current_holder_id" string="Holder"/>
                <field name="current_location_dependence_id" string="Destination Office"
                       domain="[('is_internal', '=', True)]"/>
                <filter string="In My Possession" name="in_my_possession"
                        domain="[('current_holder_id', '=', uid)]"/>
                <filter string="With Institutional Reentry" name="has_reentry"
                        domain="[('has_reentry', '=', True)]"/>
                <filter string="Currently at Tribunal" name="currently_at_tribunal"
                        domain="[('is_currently_internal', '=', True)]"/>
                <filter string="Licitaciones" name="licitacion"
                        domain="[('is_licitacion', '=', True)]"/>
                <filter string="Originated at TMC" name="origin_tmc"
                        domain="[('dependence_id.abbreviation', '=', 'TMC')]"/>
                <filter name="group_by_holder" string="Holder"
                        context="{'group_by': 'current_holder_id'}"/>
                <filter name="group_by_location" string="Destination Office"
                        context="{'group_by': 'current_location_dependence_id'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="document_exp_action_view_form" model="ir.actions.act_window">
        <field name="name">Expediente Registry</field>
        <field name="res_model">me.document_exp</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="document_exp_view_tree"/>
        <field name="search_view_id" ref="document_exp_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new expediente
            </p>
        </field>
    </record>
</odoo>
