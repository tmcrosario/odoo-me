<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree View -->
    <record id="document_exp_view_tree" model="ir.ui.view">
        <field name="name">me.registry.exp.view.tree</field>
        <field name="model">me.document_exp</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="number"/>
                <field name="period"/>
                <field name="date" string="Fecha de inicio"/>
                <field name="entry_date" string="Fecha de ingreso TMC"/>
                <field name="external_key" string="Clave Externa"/>
                <field name="dependence_id"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="document_exp_view_form" model="ir.ui.view">
        <field name="name">me.registry.exp.view.form</field>
        <field name="model">me.document_exp</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="tentative_name" placeholder="Nombre tentativo del expediente"/>
                        </h2>
                    </div>
                    <group>
                        <field name="document_object" string="Objeto (Referencia)" help="Objeto del expediente"/>
                        <field name="asunto"/>
                    </group>
                    <group>
                        <group>
                            <field name="dependence_id"/>
                            <field name="document_type_id"/>
                        </group>
                        <group>
                            <field name="number" required="1" attrs="{'class': 'oe_highlight'}"/>
                            <field name="period"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="entry_date" string="Fecha de ingreso del expediente" help="Fecha en que el expediente ingresó al TMC"/>
                            <field name="date" string="Fecha de inicio del trámite" help="Fecha en que inicia el trámite/documento"/>
                            <field name="external_key"/>
                        </group>
                        <group>
                            <field name="main_topic_ids" widget="many2many_tags" string="Tema principal (Asunto)"/>
                            <field name="secondary_topic_ids" widget="many2many_tags" string="Tema secundario" invisible="1"/>
                            <field name="document_topic_ids" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Documentos Relacionados">
                            <field name="related_document_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="document_exp_view_search" model="ir.ui.view">
        <field name="name">me.registry.exp.view.search</field>
        <field name="model">me.document_exp</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="number"/>
                <field name="external_key"/>
                <field name="dependence_id"/>
                <filter string="Este Año" name="this_year" domain="[('period', '=', context_today().year)]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Dependencia" name="group_by_dependence" context="{'group_by': 'dependence_id'}"/>
                    <filter string="Año" name="group_by_period" context="{'group_by': 'period'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="document_exp_action_view_form" model="ir.actions.act_window">
        <field name="name">Expedientes</field>
        <field name="res_model">me.document_exp</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="document_exp_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear nuevo expediente
            </p>
        </field>
    </record>
</odoo>