<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- TREE VIEW -->
    <record id="movement_view_tree"
        model="ir.ui.view">
        <field name="name">me.movement.view.tree</field>
        <field name="model">me.movement</field>
        <!-- <field name="priority">5</field> -->
        <field name="arch"
            type="xml">
            <tree>
                <field name="origin" />
                <field name="destination" />
                <field name="pages" />
                <field name="create_uid"
                    readonly="True" />
                <field name="write_uid"
                    readonly="True"
                    optional="hide" />
                <field name="create_date"
                    readonly="True"
                    optional="hide" />
            </tree>
        </field>
    </record>

