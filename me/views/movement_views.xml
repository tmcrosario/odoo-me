<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="movement_view_list" model="ir.ui.view">
        <field name="name">me.document_movement.view.list</field>
        <field name="model">me.document_movement</field>
        <field name="arch" type="xml">
            <list>
                <field name="expediente_id"/>
                <field name="date"/>
                <field name="origin_dependence_id"/>
                <field name="destination_dependence_id"/>
                <field name="user_id" readonly="1"/>
                <field name="create_date" readonly="1" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="movement_view_form" model="ir.ui.view">
        <field name="name">me.document_movement.view.form</field>
        <field name="model">me.document_movement</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="expediente_id"/>
                        <field name="date"/>
                        <field name="origin_dependence_id"/>
                        <field name="destination_dependence_id"/>
                        <field name="user_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
