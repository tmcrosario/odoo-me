<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.module.category" id="module_category_me">
        <field name="name">ME</field>
        <field name="description">Mesa de Entrada</field>
        <field name="sequence">1</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_me">
        <field name="name">ME</field>
        <field name="category_id" ref="module_category_me" />
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_me" />
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_me" />
        <field name="implied_ids" eval="[(4,ref('group_user'))]" />
        <field name="implied_by_ids" eval="[(4,ref('base.group_erp_manager'))]" />
    </record>

    <record id="group_read_only" model="res.groups">
        <field name="name">Read Only</field>
        <field name="privilege_id" ref="res_groups_privilege_me" />
    </record>
</odoo>
